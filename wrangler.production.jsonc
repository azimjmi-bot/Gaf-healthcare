{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Production Worker. No route and no custom domain: gaf.healthcare stays on
	// Hostinger until cutover is confirmed. Staging stays in wrangler.jsonc.
	"name": "gaf-healthcare-production",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"minify": true,
	"alias": { "gaf-open-next-worker": "./.open-next/worker.js" },
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		"run_worker_first": ["/_gaf/*"],
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"services": [
		{ "binding": "WORKER_SELF_REFERENCE", "service": "gaf-healthcare-production" }
	],
	"r2_buckets": [
		{ "binding": "CONTENT", "bucket_name": "gaf-content-production" },
		{ "binding": "STATIC", "bucket_name": "gaf-static-production" },
		{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "gaf-static-production" }
	],
	"vars": {
		// Indexing stays on. Do not set GAF_INDEXING; "off" is the staging noindex switch.
		"GAF_STORAGE": "r2",
		"NEXT_INC_CACHE_R2_PREFIX": "incremental-cache"
	}
}
