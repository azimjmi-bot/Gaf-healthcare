{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Isolated Phase 2 canary Worker (owner-approved name).
	// workers.dev only — no apex / gaf.healthcare routes.
	// Production R2 READ probes only — do not write production content from this Worker.
	"name": "gaf-healthcare-staging-negcache",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": true,
	"preview_urls": false,
	"observability": { "enabled": true },
	"minify": true,
	"alias": { "gaf-open-next-worker": "./.open-next/worker.js" },
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		"run_worker_first": ["/_gaf/*"],
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"services": [
		{ "binding": "WORKER_SELF_REFERENCE", "service": "gaf-healthcare-staging-negcache" }
	],
	"r2_buckets": [
		{ "binding": "CONTENT", "bucket_name": "gaf-content-production" },
		{ "binding": "STATIC", "bucket_name": "gaf-static-production" },
		{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "gaf-static-production" }
	],
	"vars": {
		"GAF_STORAGE": "r2",
		"NEXT_INC_CACHE_R2_PREFIX": "incremental-cache",
		// Canary only — production apex Worker must keep this unset.
		"GAF_NEGATIVE_CACHE": "1",
		"GAF_NEGATIVE_CACHE_TTL": "120",
		// Keep canary responses out of search indexes.
		"GAF_INDEXING": "off"
	}
}
