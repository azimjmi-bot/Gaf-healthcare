{
  "name": "gaf-healthcare",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43127",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "check:alternates": "tsx scripts/check-english-alternates.ts",
    "test": "tsx --test src/lib/*.test.ts src/lib/i18n/*.test.ts src/data/cost-articles/*.test.ts src/data/specialty-pages/*.test.ts && npm run test:specialty-engine",
    "test:specialty-engine": "NODE_OPTIONS='--conditions react-server' tsx --test src/server-tests/specialty-page.test.ts src/server-tests/doctor-specialty-hub.test.ts src/server-tests/radiation-hospital-hub.test.ts src/server-tests/hospital-specialty-hub.test.ts src/server-tests/locale-isolation.test.ts src/server-tests/curated-treatment.test.ts src/server-tests/cost-country-route.test.ts src/server-tests/english-alternates-baseline.test.ts src/server-tests/arabic-publication-gate.test.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
